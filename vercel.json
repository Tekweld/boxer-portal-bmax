{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/app.js"
    }
  ],
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/cron/expirar-cashback",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/sync-revenda-rep-rd",
      "schedule": "30 10 * * *"
    }
  ]
}
